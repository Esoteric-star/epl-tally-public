FOOTBALL_DATA_TOKEN=  # API token from football-data.org (free tier)
APP_PASSCODE=         # Shared passcode players enter to access the app
FLASK_SECRET_KEY=     # Random secret for Flask session signing, e.g. `python3 -c "import secrets; print(secrets.token_hex(32))"`
SESSION_COOKIE_SECURE=1  # Set to 0 only for local HTTP testing before TLS is deployed; must stay 1 (or unset) in production

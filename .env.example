FOOTBALL_DATA_TOKEN=  # API token from football-data.org (free tier)
APP_PASSCODE=         # Shared passcode players enter to access the app
FLASK_SECRET_KEY=     # Random secret for Flask session signing, e.g. `python3 -c "import secrets; print(secrets.token_hex(32))"`
SESSION_COOKIE_SECURE=1  # Set to 0 only for local HTTP testing before TLS is deployed; must stay 1 (or unset) in production
DATABASE_PATH=         # Path to the SQLite file, resolved relative to the repo root if not absolute. Leave unset in production -- defaults to epl.db
DEMO_MODE=             # Set to 1/true/yes for a demo run: bypasses the passcode gate and swaps in placeholder branding. Leave unset (off) in production
DEMO_SHOW_CRESTS=      # Only checked when DEMO_MODE is on. Set to 1/true/yes to render real club crests instead of the text-code fallback. Leave unset (off) in production
